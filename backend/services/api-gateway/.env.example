NODE_ENV=development
PORT=4000
SERVICE_NAME=api-gateway
REDIS_URL=redis://redis:6379

# Downstream Services
AUTH_SERVICE_URL=http://auth-service:4001
USER_SERVICE_URL=http://user-service:4002
APPLICATION_SERVICE_URL=http://application-service:4003
PROFESSIONAL_SERVICE_URL=http://professional-service:4004
MARKETPLACE_SERVICE_URL=http://marketplace-service:4005
BOOKING_SERVICE_URL=http://booking-service:4006
NOTIFICATION_SERVICE_URL=http://notification-service:4007
AI_SERVICE_URL=http://ai-service:8000

# Must match the secret in Auth Service!
JWT_ACCESS_SECRET=jeevan108_super_secret_access_key_de

# --- Rate limiting (SRD §19) ---
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=5
RATE_LIMIT_PUBLIC_WINDOW_MS=60000
RATE_LIMIT_PUBLIC_MAX=60
RATE_LIMIT_GLOBAL_WINDOW_MS=60000
RATE_LIMIT_GLOBAL_MAX=300
RATE_LIMIT_AI_WINDOW_MS=60000
RATE_LIMIT_AI_MAX=20
RATE_LIMIT_UPLOAD_WINDOW_MS=3600000
RATE_LIMIT_UPLOAD_MAX=20